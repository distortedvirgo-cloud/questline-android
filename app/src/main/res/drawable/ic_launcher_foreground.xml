    <path
        android:fillColor="#FFFFFF"
        android:pathData="M25,46.4 a2.6,2.6 0 1,0 0,5.2 a2.6,2.6 0 1,0 0,-5.2 M32,47.1 a3.4,3.4 0 1,0 0,6.8 a3.4,3.4 0 1,0 0,-6.8" />

