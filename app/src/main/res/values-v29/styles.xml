<resources>
    <!-- С API 29 система умеет принудительно затемнять «светлые» приложения;
         у нас честная тёмная тема (QuestlineTheme), поэтому чужую инверсию
         выключаем — иначе One UI/Samsung перекрашивает карточки криво,
         оставляя фон светлым. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
